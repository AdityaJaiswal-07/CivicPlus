# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file. Placeholders only below.

NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed by CORS (no trailing slash, no "*").
# Local development first; add your deployed frontend URL later.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Number of reverse-proxy hops in front of the app (0 = none). Set to 1 on Render/Railway.
TRUST_PROXY=0

# Supabase. Optional while developing without auth (protected routes then return 503); REQUIRED when NODE_ENV=production.
# URL + anon key: also used by the frontend (they are public). The service-role key is server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server-only secret. Never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Private Supabase Storage bucket for report photos (created by migration 8).
STORAGE_BUCKET=report-photos
