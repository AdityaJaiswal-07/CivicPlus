# Copy to `.env.local` and fill in YOUR project's values. Never commit real values.
# These are PUBLIC settings (they end up in the browser bundle). The Supabase
# service-role key must NEVER appear here or anywhere in the frontend.

# Backend API (include /api/v1, no trailing slash)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase project URL and the public "anon" key (Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
